{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/lab", "destination": "/", "permanent": true },
    { "source": "/lab/cases/:path*", "destination": "/field", "permanent": true },
    { "source": "/lab/cases", "destination": "/field", "permanent": true },
    { "source": "/lab/:path*", "destination": "/engine", "permanent": true },
    { "source": "/projects/:path*", "destination": "/field", "permanent": true },
    { "source": "/projects", "destination": "/field", "permanent": true },
    { "source": "/framework", "destination": "/method", "permanent": true },
    { "source": "/notes", "destination": "/method", "permanent": true },
    { "source": "/about", "destination": "/", "permanent": true },
    { "source": "/shop", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
